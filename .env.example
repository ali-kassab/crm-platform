# Copy to .env and adjust. Never commit .env.
# ---------- Database ----------
DB_NAME=crm
DB_USERNAME=crm
DB_PASSWORD=change-me-db
DB_URL=jdbc:postgresql://localhost:5432/crm

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# ---------- Security ----------
# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes

# First platform admin, created once at startup when no platform admin exists.
# Password: at least 14 characters with letters and digits. Remove it after the first start.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
CLIENT_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Mail (Mailpit locally) ----------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@crm-platform.local

# ---------- Object storage (RustFS locally, S3 in AWS) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crm-files
S3_ACCESS_KEY=crmlocal
S3_SECRET_KEY=change-me-storage
S3_PATH_STYLE=true

# ---------- Demo data (profile "demo") ----------
DEMO_PASSWORD=change-me-demo-1

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=
SPRING_PROFILES_ACTIVE=dev

# Billing (provisional commercial values; plans and prices are edited by the platform admin)
BILLING_ENFORCEMENT_ENABLED=true
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
BILLING_TRIAL_PLAN=TEAM
